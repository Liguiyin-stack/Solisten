<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Solisten.App.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,6" />
        </Style>
        <!-- 单选项在一行内排开（默认 120 的最小宽度会让三个选项折成两列，顺序看起来是乱的） -->
        <Style TargetType="RadioButton" BasedOn="{StaticResource DefaultRadioButtonStyle}">
            <Setter Property="MinWidth" Value="88" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.72" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <!-- 右侧的柔光玻璃薄片：贴住窗口右侧和底部，只有左上角是圆角；玻璃本身由聆听空间在后面绘制 -->
    <Grid x:Name="Sheet" CornerRadius="22,0,0,0" Padding="0,20,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.RowSpan="2" Height="1" VerticalAlignment="Top" Margin="22,-20,0,0" Background="{StaticResource GlassTopEdgeBrush}" IsHitTestVisible="False" />
        <Border Grid.RowSpan="2" Width="1" HorizontalAlignment="Left" Margin="0,2,0,-16" Background="{StaticResource GlassSideEdgeBrush}" IsHitTestVisible="False" />
        <Grid Padding="24,0,12,8">
            <TextBlock Text="设置" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button x:Name="CloseButton" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="8" Click="OnCloseClick"
                    ToolTipService.ToolTip="关闭 (Esc)" AutomationProperties.Name="关闭设置">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
        </Grid>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" Padding="24,0,24,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="0,0,0,8">

                <!-- 曲库文件夹 -->
                <TextBlock Text="曲库文件夹" Style="{StaticResource SectionHeader}" Margin="0,4,0,6" />
                <ItemsControl x:Name="RootList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6" ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Path}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Path}" />
                                    <TextBlock Text="{Binding Status}" FontSize="12" Opacity="0.72" />
                                </StackPanel>
                                <Button Grid.Column="1" Tag="{Binding Id}" Click="OnRescanRootClick" Padding="8" Background="Transparent" BorderThickness="0"
                                        ToolTipService.ToolTip="重新扫描" AutomationProperties.Name="重新扫描">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                </Button>
                                <Button Grid.Column="2" Tag="{Binding Id}" Click="OnRemoveRootClick" Padding="8" Background="Transparent" BorderThickness="0"
                                        ToolTipService.ToolTip="从曲库移除" AutomationProperties.Name="从曲库移除">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="NoRoots" Text="还没有曲库文件夹。" Style="{StaticResource Hint}" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                    <Button Content="添加文件夹" Click="OnAddRootClick" />
                    <Button x:Name="RescanAllButton" Content="全部重新扫描" Click="OnRescanAllClick" />
                </StackPanel>
                <TextBlock x:Name="ScanStatus" Style="{StaticResource Hint}" Margin="0,6,0,0" />

                <!-- 未导入的文件 -->
                <TextBlock x:Name="UnsupportedSummary" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                <Expander x:Name="UnsupportedExpander" Header="未导入的文件" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,6,0,0" Visibility="Collapsed">
                    <ListView x:Name="UnsupportedList" MaxHeight="220" SelectionMode="None" IsItemClickEnabled="False">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Expander>

                <!-- 播放 -->
                <TextBlock Text="播放到上下文末尾时" Style="{StaticResource SectionHeader}" />
                <RadioButtons x:Name="EndBehaviorChoice" SelectionChanged="OnEndBehaviorChanged">
                    <x:String>停止</x:String>
                    <x:String>继续下一个分组</x:String>
                </RadioButtons>

                <!-- 输出 -->
                <TextBlock Text="输出设备" Style="{StaticResource SectionHeader}" />
                <ComboBox x:Name="DeviceChoice" HorizontalAlignment="Stretch" SelectionChanged="OnDeviceChanged" />
                <TextBlock x:Name="DeviceHint" Text="共享模式：所有曲目统一转换为设备的混音格式，跨采样率也能无缝播放。" Style="{StaticResource Hint}" Margin="0,6,0,0" />

                <!-- 画布 -->
                <TextBlock Text="聆听空间" Style="{StaticResource SectionHeader}" />
                <RadioButtons x:Name="SpaceChoice" SelectionChanged="OnSpaceChanged" MaxColumns="3">
                    <x:String>安静</x:String>
                    <x:String>标准</x:String>
                    <x:String>沉浸</x:String>
                </RadioButtons>
                <TextBlock Text="安静：封面呼吸很轻、粒子很少，适合长时间使用。标准：低频有明显起伏，重音有短暂扩散。沉浸：变形和景深更强、粒子更多，适合全屏欣赏。按 I 可以随时切换。"
                           Style="{StaticResource Hint}" Margin="0,4,0,0" />

                <TextBlock Text="减少动态效果" Style="{StaticResource SectionHeader}" />
                <RadioButtons x:Name="MotionChoice" SelectionChanged="OnMotionChanged" MaxColumns="3">
                    <x:String>跟随系统</x:String>
                    <x:String>开</x:String>
                    <x:String>关</x:String>
                </RadioButtons>

                <!-- 关于 -->
                <TextBlock Text="关于" Style="{StaticResource SectionHeader}" />
                <TextBlock x:Name="AboutVersion" FontSize="13" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <TextBlock Text="Solisten 只读取你选择的本地文件：不联网、不上传音频、不改写音频文件。标签、备注和标记只保存在 Solisten 自己的数据库中。"
                           Style="{StaticResource Hint}" Margin="0,6,0,0" />
                <TextBlock x:Name="AboutData" Style="{StaticResource Hint}" Margin="0,6,0,0" IsTextSelectionEnabled="True" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                           Text="开源组件：FFmpeg（LGPL 2.1 或更高版本，以动态链接方式使用）、TagLib#（LGPL 2.1）、Win2D（MIT）、Windows App SDK（MIT）、CommunityToolkit.Mvvm（MIT）、Microsoft.Data.Sqlite / SQLite（MIT / 公有领域）、Dapper（Apache 2.0）、NAudio（MIT）、pinyin-data（MIT）。" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Content="查看许可证" Click="OnLicensesClick" />
                    <Button Content="打开数据文件夹" Click="OnDataFolderClick" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
