<Application
    x:Class="Solisten.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                柔光玻璃上的控件：按钮、文本框、下拉框、展开面板都改成半透明，让后面的玻璃透出来。
                深色主题用于深色玻璃（浅色文字），浅色主题用于浅色玻璃（深色文字）；高对比度保持系统样式。
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ButtonBackground" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#2EFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#2EFFFFFF" />
                    <SolidColorBrush x:Key="TextControlBackground" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#66000000" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#33FFFFFF" />
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#2EFFFFFF" />
                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#0FFFFFFF" />
                    <SolidColorBrush x:Key="ExpanderContentBackground" Color="#08FFFFFF" />
                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="GlassToastBackground" Color="#99101114" />
                    <SolidColorBrush x:Key="GlassToastBorder" Color="#26FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ButtonBackground" Color="#66FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#A6FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#40FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#1A000000" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#26000000" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#12000000" />
                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="#66FFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#A6FFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#40FFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#1A000000" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#26000000" />
                    <SolidColorBrush x:Key="TextControlBackground" Color="#66FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#8CFFFFFF" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#E6FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#1F000000" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#2E000000" />
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="#66FFFFFF" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#A6FFFFFF" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#40FFFFFF" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#1A000000" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#26000000" />
                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#4DFFFFFF" />
                    <SolidColorBrush x:Key="ExpanderContentBackground" Color="#33FFFFFF" />
                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#1A000000" />
                    <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#1A000000" />
                    <SolidColorBrush x:Key="GlassToastBackground" Color="#B3FAFAF8" />
                    <SolidColorBrush x:Key="GlassToastBorder" Color="#1F000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="GlassToastBackground" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="GlassToastBorder" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <FontFamily x:Key="CanvasFont">Segoe UI Variable Display</FontFamily>

            <!-- 玻璃边缘的一道柔和光线：中间亮、两端渐隐（横向用于上沿，纵向用于侧边） -->
            <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#00FFFFFF" />
                <GradientStop Offset="0.5" Color="#66FFFFFF" />
                <GradientStop Offset="1" Color="#00FFFFFF" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GlassSideEdgeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#66FFFFFF" />
                <GradientStop Offset="0.6" Color="#1AFFFFFF" />
                <GradientStop Offset="1" Color="#00FFFFFF" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GlassTopEdgeBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#66FFFFFF" />
                <GradientStop Offset="0.7" Color="#1AFFFFFF" />
                <GradientStop Offset="1" Color="#00FFFFFF" />
            </LinearGradientBrush>
        </ResourceDictionary>
    </Application.Resources>
</Application>
