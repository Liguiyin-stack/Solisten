<?xml version="1.0" encoding="utf-8"?>
<!-- 二维码登录：保持极简，只有二维码、状态、过期倒计时、重新生成和取消（设计文档 §10.2）。 -->
<ContentDialog
    x:Class="Solisten.App.Integrations.NetEaseLoginDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="扫码登录网易云音乐"
    SecondaryButtonText="重新生成"
    CloseButtonText="取消"
    DefaultButton="None"
    IsSecondaryButtonEnabled="False">

    <StackPanel Width="280" Spacing="10">
        <Border Width="208" Height="208" CornerRadius="8" Background="White" HorizontalAlignment="Center"
                AutomationProperties.Name="登录二维码">
            <Grid>
                <Image x:Name="QrImage" Stretch="Uniform" Margin="10" />
                <TextBlock x:Name="QrPlaceholder" Foreground="#99000000" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" Visibility="Collapsed" />
                <ProgressRing x:Name="Busy" Width="32" Height="32" IsActive="True" />
            </Grid>
        </Border>
        <TextBlock x:Name="StatusText" Text="正在生成二维码…" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"
                   AutomationProperties.LiveSetting="Polite" />
        <TextBlock x:Name="CountdownText" FontSize="12" Opacity="0.72" HorizontalAlignment="Center" />
        <TextBlock x:Name="AdapterNote" FontSize="12" Opacity="0.72" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" />
    </StackPanel>
</ContentDialog>
