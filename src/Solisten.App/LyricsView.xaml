<?xml version="1.0" encoding="utf-8"?>
<!--
    整屏歌词（类似 Apple Music）：用 Win2D 绘制，当前行清晰明亮，其余行按距离逐渐变淡、变模糊；
    上下边缘渐隐到透明，没有被截断的半行。点击一行跳到那里，滚轮可以翻看。
-->
<UserControl
    x:Class="Solisten.App.LyricsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:win2d="using:Microsoft.Graphics.Canvas.UI.Xaml">
    <win2d:CanvasControl x:Name="Canvas" ClearColor="Transparent" Draw="OnDraw" CreateResources="OnCreateResources"
                         PointerWheelChanged="OnWheel" Tapped="OnTapped" PointerMoved="OnPointerMoved" PointerExited="OnPointerExited" />
</UserControl>
